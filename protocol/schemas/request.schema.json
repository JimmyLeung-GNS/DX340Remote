{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DX340 request v1",
  "type": "object",
  "required": ["v", "id", "type"],
  "properties": {
    "v": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$"},
    "type": {"type": "string", "enum": ["HELLO", "AUTHORIZE", "GET_CAPABILITIES", "GET_STATE", "SUBSCRIBE_STATE", "LIST_SOURCES", "SELECT_SOURCE", "SET_PLAYING", "NEXT", "PREVIOUS", "SEEK", "ADJUST_VOLUME", "SET_SHUFFLE", "SET_REPEAT", "BROWSE", "SEARCH", "PLAY_ITEM", "GET_QUEUE", "PLAY_QUEUE_ITEM", "GET_ARTWORK"]},
    "hostEpoch": {"type": "string", "maxLength": 64},
    "source": {"type": "string", "maxLength": 256},
    "sourceEpoch": {"type": "string", "maxLength": 64},
    "args": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"not": {"enum": ["HELLO", "AUTHORIZE"]}}}}, "then": {"required": ["hostEpoch"]}},
    {"if": {"properties": {"type": {"const": "GET_QUEUE"}}}, "then": {
      "properties": {"args": {
        "type": "object",
        "properties": {"offset": {"type": "integer", "minimum": 0, "maximum": 10000}, "revision": {"type": ["string", "null"], "maxLength": 64}},
        "additionalProperties": false,
        "allOf": [{"if": {"required": ["offset"], "properties": {"offset": {"minimum": 1}}}, "then": {"required": ["revision"], "properties": {"revision": {"type": "string", "minLength": 1}}}}]
      }}
    }},
    {"if": {"properties": {"type": {"const": "ADJUST_VOLUME"}}}, "then": {
      "required": ["source", "sourceEpoch", "args"],
      "properties": {"args": {"required": ["delta", "expectedVolume", "profileId"], "properties": {
        "delta": {"type": "integer", "enum": [-1, 1]},
        "expectedVolume": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "profileId": {"type": "string", "minLength": 1, "maxLength": 64}
      }}}
    }}
  ],
  "additionalProperties": false
}
